# ===============================================
# Database Configuration (PostgreSQL)
# ===============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agrimitra
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# ===============================================
# JWT Authentication & Authorization
# ===============================================
# 256-bit secret key (min 32 characters or base64 encoded) used to sign JWT tokens
JWT_SECRET=
# Token validity in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ===============================================
# AWS S3 Storage (Soil Health Card Images)
# ===============================================
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===============================================
# Google Gemini GenAI & Grounded Search
# ===============================================
# Google AI Studio API key
GEMINI_API_KEY=
# Gemini model name (e.g. gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# ===============================================
# OpenWeatherMap Configuration
# ===============================================
# OpenWeatherMap API key (free tier 2.5 current weather)
OPENWEATHER_API_KEY=

# ===============================================
# Meta WhatsApp Cloud API Webhook & Messaging
# ===============================================
# Custom verification token configured in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=
# Temporary (~24h) or permanent System User access token from Meta App Dashboard
WHATSAPP_ACCESS_TOKEN=
# Test Phone Number ID from WhatsApp > API Setup (not the display phone number)
WHATSAPP_PHONE_NUMBER_ID=
# Optional override for Meta Graph API base URL (defaults to https://graph.facebook.com/v25.0)
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v25.0
